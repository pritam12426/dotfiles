# Tidier feedback
--fail
--show-error
--silent

# Masquerade as a modern browser running on macOS Monterrey
user-agent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36"

# Retain previous URL when following redirects
referer = ";auto"

# Wait 60 seconds before timing out
connect-timeout = 60

# Path to the cookie file your script generates
#cookie = /Users/pritam/.cache/firefox_cookies.txt

# Path to save new cookies received during a request (the "cookie jar")
#cookie-jar = "/Users/YOUR_USERNAME/Downloads/firefox_cookies.txt"
