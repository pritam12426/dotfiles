#!/bin/bash
# export NNN_PLUG="A:personal/ftp_sync"

# Description: Push files and folders to FTP server via nnn
#
# Dependencies: lftp
#
# Shell: Bash
# Author: Pritam <https://github.com/pritam12426>

set -euo pipefail

# ───── Colors ─────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ───── Configuration ─────
TMP_DIR="${TMP_DIR:-/tmp}"
FTP_CONNECTION_CREDENTIALS="${TMP_DIR}/ftp_credentials.$(pgrep nnn)"

FTP_HOST=""
FTP_USER=""
FTP_PASS=""
FTP_PORT="21"

PHONE_DIR="/sdcard/Download/$(hostname -s)/"
counter=0
prompt=true

# ───── Load or Create Credentials ─────
if [[ -f $FTP_CONNECTION_CREDENTIALS ]]; then
	echo "ftp connection found at $FTP_CONNECTION_CREDENTIALS"
	source "$FTP_CONNECTION_CREDENTIALS"
else
	echo -e "${YELLOW}No credentials found.${NC} file: $FTP_CONNECTION_CREDENTIALS"
	echo "Please enter FTP connection details."

	read -rp "Host: " FTP_HOST
	read -rp "User: " FTP_USER
	read -rsp "Password: " FTP_PASS
	echo
	read -rp "Port [21]: " FTP_PORT
	FTP_PORT="${FTP_PORT:-21}"

	echo "Saving credentials..."

	echo "$FTP_CONNECTION_CREDENTIALS"
	(
		echo "FTP_HOST='$FTP_HOST'"
		echo "FTP_USER='$FTP_USER'"
		echo "FTP_PASS='$FTP_PASS'"
		echo "FTP_PORT='$FTP_PORT'"
	) > "$FTP_CONNECTION_CREDENTIALS"

	chmod 600 "$FTP_CONNECTION_CREDENTIALS"
fi

# ftp://10.250.36.63:2635

# ───── lftp Base Command ─────
LFTP_CMD=(lftp
	-u "$FTP_USER","$FTP_PASS"
	-p "$FTP_PORT"
	"ftp://$FTP_HOST"
)

# ───── Get Selection or Current File ─────
sel="${NNN_SEL:-${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.selection}"

targets=()

if [[ -s $sel ]]; then
	while IFS= read -r -d '' i || [[ -n $i ]]; do
		targets+=("$(readlink -f -- "$i")")
		((counter++))
	done < "$sel"
else
	targets=("$(readlink -f -- "$1")")
	counter=1
fi

# ───── Confirm Upload ─────
if $prompt; then
	echo
	echo -e "${GREEN}The following files/folders will be uploaded to:${NC} ${YELLOW}$PHONE_DIR${NC}"
	echo

	for i in "${targets[@]}"; do
		printf "    - %s/${YELLOW}%s${NC}\n" "$(dirname "$i")" "$(basename "$i")"
	done

	echo
	read -rp "$counter Items proceed [Yn]? " input

	case "$input" in
	y | Y | '') ;;
	*)
		echo -e "${RED}Canceled.${NC}"
		exit 0
		;;
	esac
fi

# ───── Upload Function ─────
upload_target() {
	local target="$1"
	local base
	base="$(basename "$target")"

	if [[ -f $target ]]; then
		echo -e "${GREEN}Uploading file:${NC} $base"

		"${LFTP_CMD[@]}" -e "
			set ftp:ssl-allow true;
			set ssl:verify-certificate no;
			set net:max-retries 3;
			set xfer:clobber true;
			mkdir -p \"$PHONE_DIR\";
			put \"$target\" -o \"$PHONE_DIR$base\";
			quit
		"
	elif [[ -d $target ]]; then
		echo -e "${GREEN}Uploading directory:${NC} $base"

		"${LFTP_CMD[@]}" -e "
			set ftp:ssl-allow true;
			set ssl:verify-certificate no;
			set net:max-retries 3;
			set xfer:clobber true;
			mkdir -p \"$PHONE_DIR$base\";
			mirror -R --parallel=4 \"$target\" \"$PHONE_DIR$base\";
			quit
		"
	fi
}

# ───── Upload All Targets ─────
for target in "${targets[@]}"; do
	if [[ -e $target ]]; then
		upload_target "$target"
	else
		echo -e "${RED}Skipping missing target:${NC} $target"
	fi
done

# ───── Cleanup nnn Selection ─────
if [[ -s $sel && -p ${NNN_PIPE:-} ]]; then
	printf "-" > "$NNN_PIPE"
fi

echo
echo -e "${GREEN}Upload complete.${NC}"
read -rn1 -p "Press any key to exit..."
