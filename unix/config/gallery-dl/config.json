{
	"extractor": {
		"skip": true,

		"base-directory": "~/Downloads/yt_dlp/gallery-dl",
		"directory": [
		],
		"cookies": [
			"firefox"
		],

		"user-agent": "+chrome",
		"browser": "chrome:windows",

		"instagram": {
			"cookies": "~/.cache/safari_cookies.txt",
			"filename": "Instagram-{username}_{shortcode}.{extension}"
		},

		"reddit": {
			"filename": "sub_{subreddit}_{author}_{title}_{id}.{extension}"
		},

		"twitter": {
			"filename": "Twitter-{author[name]}_{tweet_id}_{num:>02}.{extension}"
		},

		"downloader": {},
		"output": {},
		"postprocessor": {
			"metadata": [
				{
					"name": "metadata",
					"mode": "json",
					"filename": "{directory}/{filename}.info.json"
				},
				{
					"name": "metadata",
					"mode": "xmp",
					"comment": "Source: {post_url}\nUsername: {username}\nDate: {date:%Y-%m-%d}",
					"event": "exif"
				}
			]
		}
	}
}
