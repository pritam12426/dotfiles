{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,

	"command": {
		"doc-ref": {
			"template": "Follow these rules:\n\n!`cat ~/.config/opencode/custom_prompts/doc-refactor.md`\n\nNow refactor the documentation.",
			"description": "Reflected documentation"
		},
		"gen-git_commit": {
			"template": "`cat ~/.config/opencode/custom_prompts/gen-git_commit.md`",
			"description": "Get git commit message for you changes",
		}
	},


	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true,
			"headers": {
				"CONTEXT7_API_KEY": "ctx7sk-1085b385-cc36-4337-baf8-d192defd374e"
			}
		},

		"git-mcp": {
			"type": "local",
			"command": [
				"mcp-server-git"
			],
			"enabled": true
		},
	},

	"permission": {
		"edit": "allow",
		"bash": {
			"rm -rf *": "deny",
			"sudo *": "deny",
			"su *": "deny",
			"*": "allow"
		},
		"webfetch": "allow"
	}
}
