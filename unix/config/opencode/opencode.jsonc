{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,

	"formatter": {
		"prettier": {
			"disabled": true
		},
		"dprint": {
			"command": [
				"dprint",
				"fmt",
				"--config-discovery=global",
				"--no-gitignore",
				"$FILE"
			],
			"extensions": [
				".md",
				".css",
				".html",
				".yaml",
				".yml"
			]
		}
	},

	"default_agent": "plane",
	"model": "crof/deepseek-v4-flash",
	"small_model": "opencode/big-pickle",

	// https://opencode.ai/docs/rules/#manual-instructions-in-agentsmd
	"instructions": [
		// "CONTRIBUTING.md",
		// "docs/guidelines.md",
		".cursor/rules/*.md",
		".opencode/rules/*.md"
	],

	"command": {
		"doc-ref": {
			"template": "Follow these rules:\n\n!`cat ~/.config/opencode/custom_prompts/doc-refactor.md`\n\nNow refactor the documentation.",
			"description": "Reflected documentation",
			"model": "opencode/big-pickle"
		},
		"gen-git_commit": {
			"template": "!`cat ~/.config/opencode/custom_prompts/gen-git_commit.md`",
			"agent": "plane",
			"description": "Get git commit message for you changes",
			"model": "opencode/big-pickle"
		}
	},

	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true,
			"headers": {
				"CONTEXT7_API_KEY": "ctx7sk-1085b385-cc36-4337-baf8-d192defd374e"
			}
		},
		"git-mcp": {
			"type": "local",
			"command": [
				"gitforge"
			],
			"enabled": true
		},
	},

	"permission": {
		"edit": "allow",
		"bash": {
			"rm -rf *": "deny",
			"sudo *": "deny",
			"su *": "deny",
			"*": "allow"
		},
		"webfetch": "allow"
	}
}
