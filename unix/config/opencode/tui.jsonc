{
	"$schema": "https://opencode.ai/tui.json",

	"theme": "system",
	"leader_timeout": 2000,
	"keybinds": {
		"leader": "ctrl+j",
		"command_list": "ctrl+p"
	},

	"scroll_speed": 1,
	"scroll_acceleration": {
		"enabled": false
	},

	"diff_style": "auto",
	"mouse": true,
	"attention": {
		"enabled": true,
		"notifications": true,
		"sound": true,
		// "volume": 0.4,
		// "sound_pack": "opencode.default",
		// "sounds": {
		// 	"error": "./sounds/error.mp3"
		// }
	}
}
