{
	// general
	"cli_default_open_behavior": "new_window",

	"diagnostics": {
		"inline": {
			"enabled": true
		},
		"button": true,
		"include_warnings": true
	},

	"use_system_window_tabs": true,
	"show_signature_help_after_edits": true,

	"active_pane_modifiers": {
		"inactive_opacity": 0.7,
	},

	// appearance & ui
	"theme": {
		"mode": "system",
		"light": "Ayu Light",
		"dark": "Ayu Dark"
	},

	"icon_theme": {
		"mode": "system",
		"light": "Zed (Default)",
		"dark": "Zed (Default)"
	},

	"show_whitespaces": "all",
	"whitespace_map": {
		"tab": "-",
		"space": "·"
	},

	// editor behaviour
	"auto_indent_on_paste": false,
	"autoscroll_on_clicks": true,
	// "colorize_brackets": true,

	"snippet_sort_order": "top",
	"show_edit_predictions": true,

	"edit_predictions": {
		"provider": null,
		// Turn off this shit
	},

	// https://zed.dev/docs/ai/mcp
	// ai / agents
	// "agent_servers": {
	// 	"opencode": {
	// 		"default_config_options": {
	// 			"model": "opencode/nemotron-3-ultra-free",
	// 			"default_mode": "ask"
	// 		},
	// 		"type": "registry"
	// 	}
	// },

	"agent": {
		"profiles": {
			"container-use": {
				"name": "Container Use",
				"tools": {
					"fetch": true,
					"copy_path": false,
					"find_path": true,
					"delete_path": false,
					"create_directory": true,
					"list_directory": true,
					"diagnostics": false,
					"read_file": true,
					"move_path": false,
					"grep": false,
					"edit_file": false,
					"terminal": false
				},
				"enable_all_context_servers": false,
				"context_servers": {
					"container-use": {
						"tools": {
							"environment_create": true,
							"environment_add_service": true,
							"environment_update": true,
							"environment_run_cmd": true,
							"environment_open": true,
							"environment_file_write": true,
							"environment_file_read": true,
							"environment_file_list": true,
							"environment_file_delete": true,
							"environment_checkpoint": true
						}
					}
				}
			}
		}
	},


	"restore_on_startup": "empty_tab",

	"hide_mouse": "on_typing_and_action",

	"use_system_path_prompts": false,
	"auto_signature_help": true,
	// this will how the fun definition
	"scroll_beyond_last_line": "vertical_scroll_margin",

	"auto_install_extensions": {
		"html": false,
		"toml": true,
		"git-firefly": true,
		"make": true,
		"basher": true,
		// "sql": true,
		// "java": true,
		// "neocmake": true,
		// "log": true
	},

	"auto_update_extensions": {
		"html": false
	},

	// search
	"search": {
		"button": true,
		"include_ignored": false
	},

	"seed_search_query_from_cursor": "selection",
	// "use_smartcase_search": true,

	"outline_panel": {
		// No idea what this is
		"file_icons": true,
		"default_width": 300.0,
		"button": true,
		"dock": "left",
		"scrollbar": {
			"show": "system"
		}
	},

	"prettier": {
		"allowed": false,
	},

	"minimap": {
		"show": "always",
		// "thumb": "always",
		// "current_line_highlight": null
	},

	// "soft_wrap": "prefer_line",
	// "soft_wrap": "editor_width",
	"soft_wrap": "bounded",
	"preferred_line_length": 83,
	"tab_size": 4,
	"hard_tabs": true,
	"auto_update": false,
	"autosave": "on_focus_change",
	// "wrap_guides": [83],

	"toolbar": {
		// "code_actions": true,
		"agent_review": false
	},


	// FONTS
	"buffer_font_family": "Iosevka",
	// "buffer_font_family": "PT Mono",
	// "buffer_font_family": "JetBrains Mono",
	// "buffer_font_family": "Cascadia Mono",
	// "buffer_font_family": "Monaspace Argon",
	// "buffer_font_family": "Monaspace Neon",

	"buffer_font_fallbacks": [
		"JetBrainsMono Nerd Font Propo"
	],

	"buffer_font_features": {
		"calt": true
	},

	"line_indicator_format": "long",

	// "ui_font_family": ".SystemUIFont",
	// "ui_font_family": "Helvetica",
	// "ui_font_size": 18,
	"ui_font_family": "Monaspace Neon",
	// "ui_font_family": "Monaspace Krypton",
	// "ui_font_family": "IBM Plex Sans",
	// "ui_font_family": "Cascadia Mono",
	// "ui_font_family": "JetBrains Mono",

	"ui_font_fallbacks": [
		"JetBrainsMono Nerd Font Mono"
	],


	// TERMINAL
	"terminal": {
		"max_scroll_history_lines": 1000,
		"default_height": 300.0,
		"button": true,
		"env": {
			"GIT_EDITOR": "zed --wait",
			// "VISUAL": "zed --wait",
			"EDITOR": "zed--wait"
		},
		"blinking": "terminal_controlled",
		"font_family": "Cascadia Mono",
		"working_directory": "current_project_directory",
		"font_fallbacks": [
			"JetBrainsMono Nerd Font Mono"
		]
	},

	"format_on_save": "off",
	"always_treat_brackets_as_autoclosed": true,

	"tabs": {
		"file_icons": true,
		"git_status": true,
		// "close_position": "left"
	},

	"status_bar": {
	    // "line_endings_button": true,
	},


	// GIT
	"git": {
		// "git_gutter": "tracked_files",
		"inline_blame": {
			// "show_commit_summary": true,
			"enabled": true,
			"delay_ms": 500
		},
		"branch_picker": {
			"show_author_name": true,
		},
		"hunk_style": "staged_hollow",
		"path_style": "file_path_first"
	},

	"git_panel": {
		// "sort_by_path": true,
		"tree_view": true,
		"file_icons": true,
		"show_count_badge": true,
		// "status_style": "label_color",
		"status_style": "icon",
		"default_width": 300.0,
		"collapse_untracked_diff": true,
		"dock": "left",
	},

	"scrollbar": {
		"show": "auto",
		"cursors": true,
		"git_diff": false
	},

	"indent_guides": {
		"line_width": 2,
		"active_line_width": 4,
		"coloring": "indent_aware"
	},

	"inlay_hints": {
		"enabled": true,
		"edit_debounce_ms": 100,
		"scroll_debounce_ms": 20,
		// TODO: you have to work here much
	},

	"semantic_tokens": "combined",
	"document_symbols": "on",
	"document_folding_ranges": "on",
	"use_autoclose": true,

	"sticky_scroll": {
		"enabled": true  // Whether to stick scopes to the top of the editor. Disabled by default.
	},

	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},

	"experimental.theme_overrides": {
		"syntax": {
			"comment": {
				"font_style": "italic",
				"font_weight": 400
			},
		},
		"editor.background": "#000000",
		"terminal.background": "#000000",
		// "border": "#444444"
	},

	"project_panel": {
		// "hide_root": true,
		// "hide_hidden": true,
		"bold_folder_labels": true,
		"git_status_indicator": true,
		"scrollbar": {
			"show": "system"
		},
		"default_width": 300,
		"starts_open": false,
		"dock": "right"
	},

	"collaboration_panel": {
		"button": false
	},

	"confirm_quit": true,

	// NODE RUNTIME
	"node": {
		// do not download the new node version just the system system one

		"path": "/Users/pritam/.local/dev-tools/node-v24.18.0/bin/node",
		"npm_path": "/Users/pritam/.local/dev-tools/node-v24.18.0/bin/npm",
		// "path": "/opt/homebrew/bin/bun",
		// "npm_path": "/opt/homebrew/bin/bun",
		"ignore_system_version": false
	},


	// VIM / HELIX
	"helix_mode": true,
	// "vim_mode": true,
	"vim": {
		"use_system_clipboard": "on_yank",
		"use_smartcase_find": true,
		"highlight_on_yank_duration": 200,
		"toggle_relative_line_numbers": true,
	},

	"command_aliases": {
		"ll": "language_selector::Toggle",
		"rr": "workspace::Reload",
		"lsp": "editor::RestartLanguageServer",

		"snake": "editor::ConvertToSnakeCase",
		"kebab": "editor::ConvertToKebabCase",
		"title": "editor::ConvertToTitleCase",
		"camel": "editor::ConvertToLowerCamelCase",
		"ucamel": "editor::ConvertToUpperCamelCase"
	},


	// FILE DISCOVERY

	"file_scan_exclusions": [
		"**/CVS",
		".git/",
		"**/.DS_Store",
		"**/Thumbs.db"
	],

	"file_scan_inclusions": [
		".env*",
		".gitignore"
	],


	// FILE TYPES

	"file_types": {
		"YAML": [
			"*clang*"
		],
		"C": [
			"*.h"
		],
		"C++": [
			"*.ino",
			"*.hpp"
		],
		"TOML": [
			".editorconfig"
		],
		// "TypeScript": [
		// 	"*.js"
		// ]
	},

	// LANGUAGES
	"languages": {
		"Typst": {},

		"HTML+ERB": {
			"enable_language_server": false
		},


		"JS+ERB": {
			"enable_language_server": false
		},

		"TSX": {
			"enable_language_server": false
		},

		"D2": {
			"formatter": {
				"external": {
					"command": "d2",
					"arguments": [
						"fmt"
					]
				}
			}
		},

		"CSS": {
			"enable_language_server": false,
			"formatter": {
				"external": {
					"command": "dprint",
					"arguments": [
						"fmt",
						"--config-discovery=global",
						"--no-gitignore",
						"--stdin",
						"{buffer_path}"
					]
				}
			}
		},

		"Proto": {
			"formatter": {
				"external": {
					"command": "/Library/Developer/CommandLineTools/usr/bin/clang-format",
					"arguments": [
						"--style=file:/Users/pritam/Developer/git_repository/dotfiles/global/clang_format_config/clang_fomat_proto.yml",
						"--assume-filename=.proto"
					]
				}
			}
		},

		"JavaScript": {
			"enable_language_server": false,
			"formatter": {
				"external": {
					"command": "/Library/Developer/CommandLineTools/usr/bin/clang-format",
					"arguments": [
						"--style=file:/Users/pritam/Developer/git_repository/dotfiles/global/clang_format_config/clang_fomat_type-script.yml",
						"--assume-filename=.js"
					]
				}
			}
		},

		"TypeScript": {
			// "show_wrap_guides": true,
			"enable_language_server": false,
			"formatter": {
				"external": {
					"command": "/Library/Developer/CommandLineTools/usr/bin/clang-format",
					"arguments": [
						"--style=file:/Users/pritam/Developer/git_repository/dotfiles/global/clang_format_config/clang_fomat_type-script.yml",
						"--assume-filename=.ts"
					]
				}
			}
		},

		"Dart": {
			"soft_wrap": "preferred_line_length"
		},

		"Hurl": {
			"formatter": {
				"external": {
					"command": "hurlfmt",
					"arguments": [
						"--no-color",
						"{buffer_path}"
					]
				}
			}
		},

		"C++": {
			"formatter": {
				"external": {
					"command": "clang_format_cpp_c_wrap",
					"arguments": [
						"--assume-filename={buffer_path}"
					]
				}
			}
		},

		"C": {
			"show_wrap_guides": true,
			"formatter": {
				"external": {
					"command": "clang_format_cpp_c_wrap",
					"arguments": [
						"--assume-filename={buffer_path}"
					]
				}
			}
		},

		"Java": {
			"show_wrap_guides": true,
			"formatter": {
				"external": {
					"command": "/Library/Developer/CommandLineTools/usr/bin/clang-format",
					"arguments": [
						"--style=file:/Users/pritam/Developer/git_repository/dotfiles/global/clang_format_config/clang_fomat_java.yml",
						"--assume-filename=.java"
					]
				}
			}
		},

		"Swift": {
			"formatter": {
				"external": {
					"command": "/Library/Developer/CommandLineTools/usr/bin/swift-format",
					"arguments": [
						"--configuration=/Users/pritam/Developer/git_repository/dotfiles/global/clang_format_config/swift-format.json",
						"--assume-filename={buffer_path}"
					]
				}
			}
		},

		"JSON": {
			"formatter": {
				"external": {
					"command": "/Library/Developer/CommandLineTools/usr/bin/clang-format",
					"arguments": [
						"--style=file:/Users/pritam/Developer/git_repository/dotfiles/global/clang_format_config/clang_fomat_json.yml",
						"--assume-filename=.json"
					]
				}
			}
		},

		"JSONC": {
			"formatter": {
				"external": {
					"command": "/Library/Developer/CommandLineTools/usr/bin/clang-format",
					"arguments": [
						"--style=file:/Users/pritam/Developer/git_repository/dotfiles/global/clang_format_config/clang_fomat_json.yml",
						"--assume-filename=.json"
					]
				}
			}
		},

		"HTML": {
			"prettier": null,
			"formatter": {
				"external": {
					"command": "dprint",
					"arguments": [
						"fmt",
						"--config-discovery=global",
						"--no-gitignore",
						"--stdin",
						"{buffer_path}"
					]
				}
			}
		},

		"XML": {
			"prettier": null,
			"formatter": {
				"external": {
					"command": "/Users/pritam/.config/tidy/tidy-xml.sh",
					"arguments": [
						"{buffer_path}"
					]
				}
			}
		},

		"Python": {
			"language_servers": [
				"ruff",
				"pyright"
			],

			"formatter": [
				{
					"language_server": {
						"name": "ruff"
					}
				}
			]
		},

		"YAML": {
			"hard_tabs": false,
			"tab_size": 2,
			"formatter": {
				"external": {
					"command": "dprint",
					"arguments": [
						"fmt",
						"--config-discovery=global",
						"--no-gitignore",
						"--stdin",
						"{buffer_path}"
					]
				}
			}
		},

		"Markdown-Inline": {
			"formatter": {
				"external": {
					"command": "dprint",
					"arguments": [
						"fmt",
						"--config-discovery=global",
						"--no-gitignore",
						"--stdin",
						"{buffer_path}"
					]
				}
			}
		},

		"Markdown": {
			"enable_language_server": false,
			"formatter": {
				"external": {
					"command": "dprint",
					"arguments": [
						"fmt",
						"--config-discovery=global",
						"--no-gitignore",
						"--stdin",
						"{buffer_path}"
					]
				}
			}
		},

		"Make": {
			"enable_language_server": false,
			"soft_wrap": "none",
			"hard_tabs": true
		},

		"Rust": {
			"show_edit_predictions": true,
			// "hard_tabs": true,
			"formatter": "language_server"
		},

		"SQL": {
			"prettier": null,
			"auto_indent_on_paste": false,
			"formatter": {
				"external": {
					"command": "sleek",
					"arguments": []
				}
			}
		},

		"CMake": {
			"prettier": null,
			"hard_tabs": false,
			"tab_size": 2,
			"formatter": "language_server"
		},

		"Shell Script": {
			"formatter": {
				"external": {
					"command": "shfmt",
					// Change `--indent 2` to match your preferred tab_size
					"arguments": [
						"--space-redirects",
						"--simplify",
						"--indent",
						"0",
						"--filename",
						"{buffer_path}"
					]
				}
			}
		},

		"TOML": {
			"language_servers": [
				"taplo"
			],
			"formatter": {
				"external": {
					"command": "/Users/pritam/.config/taplo/taplo-zed.sh",
					"arguments": [
						"{buffer_path}"
					]
				}
			}
		},

		"Zig": {
			"formatter": "language_server",
			"hard_tabs": false,
			"preferred_line_length": 110,
		}
	},

	"lsp": {
		"jdtls": {
			"settings": {
				"java_home": "/Users/pritam/.local/dev-tools/jdk-21.0.8.jdk/Contents/Home",
				"lombok_support": true,
				"jdk_auto_download": false,
			},
			"binary": {
				// "path": "/Users/pritam/.local/dev-tools/jdt-language-server-1.51.0/bin/jdtls",
				"ignore_system_version": false
			}
		},

		"taplo": {
			"binary": {
				"arguments": [
					"lsp",
					"tcp"
				],
				"ignore_system_version": false
			}
		},

		"ruff": {
			"binary": {
				"ignore_system_version": false
			},
			"initialization_options": {
				"settings": {
					"configuration": "~/.config/ruff/ruff.toml"
				}
			}
		},

		"gopls": {
			"initialization_options": {},
			"binary": {
				"ignore_system_version": false
			}
		},

		"dart": {
			"settings": {
				"lineLength": 140
			}
		},

		"clangd": {
			"fetch": {
				"pre_release": true,
			},
			"binary": {
				"ignore_system_version": false,
				"arguments": [
					// "--header-insertion=never",
					"--function-arg-placeholders=0",
					"--clang-tidy",
					// "--background-index",
					"--all-scopes-completion"
				]
			},

			"initialization_options": {
				"fallbackFlags": [
					// "-std=c++20"
				],
				"clangdFileStatus": true,
				"index": {
					"background": true
				}
			}
		},

		"tinymist": {
			// https://github.com/Myriad-Dreamin/tinymist/blob/main/editors/neovim/Configuration.md
			"settings": {
				"formatterIndentSize": 4,
				"formatterMode": "typstyle",
				// "compileStatus": "enable"
				// 	"exportPdf": "onSave",
				// 	"outputPath": "$root/$name"
			},

			// https://www.reddit.com/r/typst/comments/1ow2a0r/anyone_using_zed_to_work_with_typst/
			// http://localhost:23635/
			"initialization_options": {
				"preview": {
					"background": {
						"enabled": true
					},
					// "browsing": {
					// 	"args": ["--open"]
					// },
					"partialRendering": true,
					// "invertColors": {
					// 	"image": "never"
					// },
					"invertColors": "never",
					"refresh": "onSave"
				}
			}
		}
	}
}
